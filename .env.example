DEEPSEEK_API_KEY=
VALLEYTOWN_JEV_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-1.13.0
DEEPSEEK_BUDGET_CNY=10
JEV_BUDGET_CNY=10
# 本地估算汇率；可在设置中修改，不自动获取市场汇率
JEV_USD_CNY=7
PORT=3001
# Live mode uses configured models; demo mode is explicitly labelled rule-based.
MODEL_MODE=live
DATA_DIR=./data

# Optional native TLS transport; default fetch falls back to curl after a transient failure.
# MODEL_HTTP_TRANSPORT=curl
