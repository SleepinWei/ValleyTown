# Optional: leave both empty for a standalone browser demo (no API fees).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys are also supported via VITE_SUPABASE_ANON_KEY.
# Only publishable/anon keys belong here. Never prefix model or service-role secrets with VITE_.

# Optional GitHub Pages repository path (Vercel / Netlify normally use /).
# VITE_BASE_PATH=/ValleyTown/
